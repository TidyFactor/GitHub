{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RFCDocument",
  "type": "object",
  "required": [
    "rfc_id",
    "title",
    "status",
    "author",
    "created_date",
    "summary",
    "motivation",
    "detailed_design"
  ],
  "properties": {
    "rfc_id": { "type": "string" },
    "title": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["Draft", "Review", "Accepted", "Rejected", "Superseded"]
    },
    "author": { "type": "string" },
    "created_date": { "type": "string" },
    "summary": { "type": "string" },
    "motivation": { "type": "string" },
    "detailed_design": { "type": "string" },
    "alternatives": { "type": "string" },
    "breaking_changes": { "type": "string" },
    "security_impact": { "type": "string" }
  }
}
