{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHubRepositoryBlueprint",
  "type": "object",
  "required": ["repository", "documentation", "governance", "security", "automation"],
  "properties": {
    "repository": {
      "type": "object",
      "required": ["type", "default_branch"],
      "properties": {
        "type": { "type": "string" },
        "default_branch": { "type": "string" },
        "has_issues": { "type": "boolean" },
        "has_discussions": { "type": "boolean" },
        "has_wiki": { "type": "boolean" }
      }
    },
    "documentation": {
      "type": "object",
      "required": ["readme", "license", "changelog", "security_policy", "contributing"],
      "properties": {
        "readme": { "type": "object" },
        "license": { "type": "object" },
        "changelog": { "type": "object" },
        "security_policy": { "type": "object" },
        "contributing": { "type": "object" }
      }
    },
    "governance": { "type": "object" },
    "security": { "type": "object" },
    "automation": { "type": "object" }
  }
}
