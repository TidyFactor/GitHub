{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSSAuditReport",
  "type": "object",
  "required": [
    "repository",
    "timestamp",
    "overall_score",
    "maturity_tier",
    "dimensions",
    "treatment_plan"
  ],
  "properties": {
    "repository": { "type": "string" },
    "timestamp": { "type": "string" },
    "overall_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "maturity_tier": {
      "type": "string",
      "enum": ["Enterprise OSS", "Production OSS", "Emerging OSS", "Code Dump"]
    },
    "dimensions": {
      "type": "object",
      "required": [
        "identity",
        "documentation",
        "cx_onboarding",
        "good_first_issues",
        "community",
        "governance",
        "sustainability",
        "security",
        "releases",
        "discoverability"
      ],
      "properties": {
        "identity": { "type": "number" },
        "documentation": { "type": "number" },
        "cx_onboarding": { "type": "number" },
        "good_first_issues": { "type": "number" },
        "community": { "type": "number" },
        "governance": { "type": "number" },
        "sustainability": { "type": "number" },
        "security": { "type": "number" },
        "releases": { "type": "number" },
        "discoverability": { "type": "number" }
      }
    },
    "treatment_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["priority", "category", "action", "remedy_command"],
        "properties": {
          "priority": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "category": { "type": "string" },
          "action": { "type": "string" },
          "remedy_command": { "type": "string" }
        }
      }
    }
  }
}
