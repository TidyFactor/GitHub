{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHubPermissionMatrix",
  "type": "object",
  "required": ["organization", "teams", "repositories"],
  "properties": {
    "organization": { "type": "string" },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "slug", "privacy"],
        "properties": {
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "privacy": { "type": "string", "enum": ["secret", "closed"] },
          "parent": { "type": ["string", "null"] }
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "team_permissions"],
        "properties": {
          "name": { "type": "string" },
          "team_permissions": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": ["pull", "triage", "push", "maintain", "admin"]
            }
          }
        }
      }
    }
  }
}
